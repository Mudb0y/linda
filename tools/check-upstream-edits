#!/usr/bin/env python3
"""Fails when the record of how this tree departs from NVDA's and the tree disagree.

Every change to a file that came from NVDA costs something at each upstream merge, so each one is
listed in tools/upstream-edits.txt with its reason; a directory deleted whole is listed once, by its
path with a slash at the end. A file added beside upstream's in source/ or
tests/unit is listed there too: it can shadow a module, and an upstream release that adds the same
path turns it into a conflict. Each reason says which kinds of edit it explains. For a Python file
the kind that says Windows runs the change too is checked against the code: it must be given
exactly when the file, with each test of sys.platform decided as on Windows, differs from
upstream's, because a change Windows runs is one a merge has to weigh for Windows as well.

Some upstream files are forked rather than edited: linuxPlatform.finder loads a replacement in
place of each module in its replacedModules, and source/linda.py does what source/nvda.pyw
does. The upstream files stay as they are, so upstream's changes to them merge without a conflict
into files that never run on Linux. tools/upstream-forks.txt records the upstream object each fork
was last brought up to date with, and a fork whose upstream file has moved on fails here. So does a
Nix pin of nvda-cldr, eSpeak NG or sonic that is not the revision upstream's submodule names. A liblouis from nixpkgs
that is not the release upstream's submodule pins is reported without failing, because nixpkgs,
not this tree, decides when that moves.

This reads git objects and files only. It never imports NVDA's code, so it runs anywhere. The
upstream branch it compares against is the one tools/upstream-ref names, so a clone has it only
when that branch is pushed beside main.
"""

import ast
import itertools
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import NamedTuple

TOOLS = Path(__file__).resolve().parent
EDITS = "tools/upstream-edits.txt"
FORKS = "tools/upstream-forks.txt"
FINDER = "source/linuxPlatform/finder.py"
#: What the Nix expressions fetch that upstream pins as a submodule: the submodule's path, the
#: expression, and the repository its fetchFromGitHub names just before the revision.
NIX_PINS = (
	("include/nvda-cldr", "nix/nvda-cldr.nix", "nvda-cldr"),
	("include/espeak", "nix/espeak-ng.nix", "espeak-ng"),
	("include/sonic", "nix/espeak-ng.nix", "sonic"),
)
LOUIS_LINK = "include/liblouis"

#: Where an added file is ours by construction rather than something beside upstream's.
OUR_DIR = "source/linuxPlatform/"
OUR_FILES = ("source/linda.py",)
#: Where an added file sits among upstream's modules or tests.
UPSTREAM_DIRS = ("source", "tests/unit")
#: Where the finder loads each replacement from, at the module's own path.
REPLACEMENTS = "source/linuxPlatform/replacements/"
#: Forks the finder does not know about, and the file of ours that carries each.
MIRRORED = {"source/nvda.pyw": "source/linda.py"}
#: The kinds of edit, as the edits list's header explains. Each reason starts with one, and an entry
#: whose edits are of several kinds starts a line with each.
EDIT_KINDS = ("import safety:", "Linux runtime:", "every platform:", "repository:")
#: The kind that says Windows runs the change too.
WINDOWS_TOO = "every platform:"
#: How the reason of a deletion starts.
DELETED = "repository: deleted"
KIND = re.compile("|".join(re.escape(kind) for kind in EDIT_KINDS))


class Failure(Exception):
	pass


def git(*args: str) -> str:
	done = subprocess.run(["git", *args], capture_output=True, text=True, check=False)
	if done.returncode != 0:
		raise Failure(f"git {' '.join(args)}: {done.stderr.strip()}")
	return done.stdout


def paths(*args: str) -> set[str]:
	return {p for p in git(args[0], "-z", *args[1:]).split("\0") if p}


def upstreamRef() -> str:
	done = subprocess.run([TOOLS / "upstream-ref"], capture_output=True, text=True, check=False)
	if done.returncode != 0:
		raise Failure(done.stderr.strip())
	return done.stdout.strip()


def objectAt(base: str, path: str) -> str | None:
	"""The id of what upstream holds at path, a blob or a submodule's commit, or None."""
	entry = git("ls-tree", "-z", base, "--", path).rstrip("\0")
	if not entry:
		return None
	return entry.split("\t", 1)[0].split()[2]


class Entry(NamedTuple):
	#: The entry's first line, split into words, the path first.
	words: list[str]
	#: The indented lines beneath it.
	reason: list[str]


def readLedger(path: str) -> dict[str, Entry]:
	entries: dict[str, Entry] = {}
	entry = None
	for line in Path(path).read_text(encoding="utf-8").splitlines():
		if line[:1] in ("", "#"):
			continue
		if line[:1] in (" ", "\t"):
			if entry is None:
				raise Failure(f"{path}: a reason comes before any path: {line.strip()}")
			entry.reason.append(line.strip())
			continue
		entry = Entry(line.split(), [])
		if entry.words[0] in entries:
			raise Failure(f"{path}: {entry.words[0]} is listed twice")
		entries[entry.words[0]] = entry
	if unexplained := [p for p, e in entries.items() if not e.reason]:
		raise Failure(f"{path}: no reason given for {', '.join(unexplained)}")
	return entries


def keptInDirectory(path: str, entry: Entry) -> list[str]:
	"""The paths beneath the directory that its entry says this tree keeps."""
	if not entry.reason[0].startswith(DELETED):
		raise Failure(f"{EDITS}: {path} is a directory, and only a deletion can be listed as one")
	kept = entry.words[2:] if entry.words[1:2] == ["except"] else []
	if entry.words[1:] and not kept:
		raise Failure(f"{EDITS}: {path} may be followed only by except and the paths it keeps")
	return kept


def deletedDirectories(base: str, ledger: dict[str, Entry]) -> dict[str, Entry]:
	"""The ledger with each entry for a directory given as an entry for every file of upstream's in it.

	A directory is listed as its path with a slash at the end, and after it, once the word except,
	the paths beneath it that this tree keeps. Only a deletion can be listed that way.
	"""
	expanded: dict[str, Entry] = {}
	for path, entry in ledger.items():
		if not path.endswith("/"):
			expanded[path] = entry
			continue
		kept = keptInDirectory(path, entry)
		inside = paths("ls-tree", "-r", "--name-only", base, "--", path)
		if missing := [k for k in kept if path + k not in inside]:
			raise Failure(f"{EDITS}: {path} keeps {', '.join(missing)}, which upstream does not have there")
		for file in sorted(inside - {path + k for k in kept}):
			if file in ledger:
				raise Failure(f"{EDITS}: {file} is listed twice, on its own and under {path}")
			expanded[file] = entry
	return expanded


def replacedModules() -> tuple[str, ...]:
	tree = ast.parse(Path(FINDER).read_text(encoding="utf-8"), FINDER)
	for node in tree.body:
		target = node.target if isinstance(node, ast.AnnAssign) else None
		if isinstance(node, ast.Assign) and len(node.targets) == 1:
			target = node.targets[0]
		if isinstance(target, ast.Name) and target.id == "replacedModules" and node.value:
			return tuple(ast.literal_eval(node.value))
	raise Failure(f"{FINDER} no longer assigns replacedModules a literal tuple")


class WindowsView(ast.NodeTransformer):
	"""Reduces a module to the code Windows runs.

	Each test of sys.platform is decided as Windows decides it, and the code it keeps from Windows is
	dropped. An annotation quoted so that it is not evaluated is read as the expression it holds.
	"""

	def visit_Compare(self, node: ast.Compare) -> ast.AST:
		self.generic_visit(node)
		if len(node.ops) != 1 or not isinstance(node.ops[0], ast.Eq | ast.NotEq):
			return node
		left, right = node.left, node.comparators[0]
		if ast.unparse(right) == "sys.platform":
			left, right = right, left
		if ast.unparse(left) != "sys.platform" or not isinstance(right, ast.Constant):
			return node
		return ast.Constant((right.value == "win32") == isinstance(node.ops[0], ast.Eq))

	def visit_BoolOp(self, node: ast.BoolOp) -> ast.AST:
		self.generic_visit(node)
		decisive = isinstance(node.op, ast.Or)
		kept = []
		for value in node.values:
			if not isDecided(value):
				kept.append(value)
			elif value.value == decisive:
				return ast.Constant(decisive)
		if len(kept) <= 1:
			return kept[0] if kept else ast.Constant(not decisive)
		node.values = kept
		return node

	def visit_IfExp(self, node: ast.IfExp) -> ast.AST:
		self.generic_visit(node)
		if isDecided(node.test):
			return node.body if node.test.value else node.orelse
		return node

	def visit_If(self, node: ast.If) -> ast.AST | list[ast.stmt] | None:
		self.generic_visit(node)
		if isDecided(node.test):
			return (node.body if node.test.value else node.orelse) or None
		return node

	def visit_arg(self, node: ast.arg) -> ast.AST:
		node.annotation = unquoted(node.annotation)
		return self.generic_visit(node)

	def visit_AnnAssign(self, node: ast.AnnAssign) -> ast.AST:
		node.annotation = unquoted(node.annotation)
		return self.generic_visit(node)

	def visit_FunctionDef(self, node: ast.FunctionDef) -> ast.AST:
		node.returns = unquoted(node.returns)
		return self.generic_visit(node)

	visit_AsyncFunctionDef = visit_FunctionDef


def isDecided(node: ast.AST) -> bool:
	return isinstance(node, ast.Constant) and isinstance(node.value, bool)


def unquoted(annotation: ast.expr | None) -> ast.expr | None:
	if isinstance(annotation, ast.Constant) and isinstance(annotation.value, str):
		return ast.parse(annotation.value, mode="eval").body
	return annotation


def asWindowsRunsIt(source: str, path: str) -> tuple[set[tuple], list[str]]:
	"""The module's top-level imports, and the rest of its code, as Windows runs them.

	The imports are a set, since a guarded import goes after the module's others.
	"""
	try:
		tree = WindowsView().visit(ast.parse(source, path))
	except SyntaxError as error:
		raise Failure(f"{path}: {error}") from None
	imports = set()
	code = []
	for node in tree.body:
		if isinstance(node, ast.Import):
			imports |= {(None, alias.name, alias.asname) for alias in node.names}
		elif isinstance(node, ast.ImportFrom):
			module = "." * node.level + (node.module or "")
			imports |= {(module, alias.name, alias.asname) for alias in node.names}
		else:
			code.append(ast.dump(node))
	return imports, code


def windowsRunsAChange(base: str, path: str) -> bool:
	theirImports, theirCode = asWindowsRunsIt(git("show", f"{base}:{path}"), path)
	ourImports, ourCode = asWindowsRunsIt(Path(path).read_text(encoding="utf-8"), path)
	# Importing a standard library module that the file did not import changes nothing it does.
	added = {name.partition(".")[0] for module, name, _as in ourImports - theirImports if module is None}
	return (
		ourCode != theirCode
		or bool(theirImports - ourImports)
		or len(ourImports - theirImports) != len(added)
		or not added <= sys.stdlib_module_names
	)


def checkKinds(base: str, ledger: dict[str, Entry]) -> list[str]:
	unlabelled, buried, unsaid, overstated = [], [], [], []
	for path, entry in sorted(ledger.items()):
		if not entry.reason[0].startswith(EDIT_KINDS):
			unlabelled.append(path)
		lineStarts = set(itertools.accumulate((len(line) + 1 for line in entry.reason), initial=0))
		if any(m.start() not in lineStarts for m in KIND.finditer(" ".join(entry.reason))):
			buried.append(path)
		if not path.endswith(".py") or objectAt(base, path) is None or not Path(path).is_file():
			continue
		saysSo = any(line.startswith(WINDOWS_TOO) for line in entry.reason)
		if saysSo != windowsRunsAChange(base, path):
			(overstated if saysSo else unsaid).append(path)
	errors = []
	for found, problem in (
		(unlabelled, f"reason not starting with one of {', '.join(EDIT_KINDS)}:"),
		(buried, "a kind of edit inside a line rather than at the start of one:"),
		(unsaid, f"Windows runs a change, but no line of the reason starts {WINDOWS_TOO}"),
		(overstated, f"a line starts {WINDOWS_TOO}, but Windows runs the same code as upstream:"),
	):
		if found:
			errors.append(problem)
			errors += found
	return errors


def checkEdits(base: str) -> tuple[list[str], int]:
	changed = paths("diff", "--no-renames", "--name-only", "--diff-filter=MDT", base, "--", ".")
	added = paths("diff", "--no-renames", "--name-only", "--diff-filter=A", base, "--", *UPSTREAM_DIRS)
	added |= paths("ls-files", "--others", "--exclude-standard", "--", *UPSTREAM_DIRS)
	added = {p for p in added if not p.startswith(OUR_DIR) and p not in OUR_FILES}
	ledger = deletedDirectories(base, readLedger(EDITS))
	listed = set(ledger)
	errors = checkKinds(base, ledger)
	if unlisted := sorted(changed - listed):
		errors.append("edited, deleted or changed in type but not listed:")
		errors += unlisted
	if unlisted := sorted(added - listed):
		errors.append("added among upstream's files but not listed:")
		errors += unlisted
	if stale := sorted(listed - changed - added):
		errors.append("listed but identical to upstream:")
		errors += stale
	return errors, len(changed | added)


def moduleFile(base: str, module: str) -> str:
	stem = "source/" + module.replace(".", "/")
	for candidate in (f"{stem}/__init__.py", f"{stem}.py"):
		if objectAt(base, candidate):
			return candidate
	raise Failure(f"{FINDER} replaces {module}, which upstream does not have")


def checkForks(base: str) -> tuple[list[str], int]:
	forked = dict(MIRRORED)
	for module in replacedModules():
		upstreamFile = moduleFile(base, module)
		forked[upstreamFile] = REPLACEMENTS + upstreamFile.removeprefix("source/")
	listed = readLedger(FORKS)
	louis = listed.pop(LOUIS_LINK, None)
	if louis is None or len(louis.words) != 3:
		raise Failure(f"{FORKS}: {LOUIS_LINK} needs the commit upstream pins and its release")
	errors = []
	if unlisted := sorted(forked.keys() - set(listed)):
		errors.append(f"forked from upstream but not in {FORKS}:")
		errors += unlisted
	if stale := sorted(set(listed) - forked.keys()):
		errors.append(f"in {FORKS} but no longer forked:")
		errors += stale
	for path in sorted(forked.keys() & set(listed)):
		words = listed[path].words
		recorded = words[1] if len(words) == 2 else None
		if recorded is None:
			errors.append(f"{FORKS}: {path} needs the upstream object the fork matches")
			continue
		current = objectAt(base, path)
		if current != recorded:
			errors.append(
				f"upstream changed {path}: read git diff {recorded} {current}, carry what applies"
				f" into {forked[path]}, then record {current} in {FORKS}",
			)
	return errors, len(forked)


def checkNixPins(base: str) -> list[str]:
	errors = []
	for link, nixFile, repo in NIX_PINS:
		pin = objectAt(base, link)
		nix = Path(nixFile).read_text(encoding="utf-8")
		found = re.search(rf'\brepo = "{re.escape(repo)}";\s*rev = "([0-9a-f]{{40}})";', nix)
		fetched = found[1] if found else "no revision"
		if fetched != pin:
			errors.append(
				f"upstream pins {repo} at {pin}, but {nixFile} fetches {fetched}: set its rev and hash to it"
			)
	return errors


def reportLiblouis(base: str) -> None:
	_path, recordedPin, release = readLedger(FORKS)[LOUIS_LINK].words
	pin = objectAt(base, LOUIS_LINK)
	if pin != recordedPin:
		print(f"liblouis: upstream now pins {pin}, not {recordedPin}; record its release in {FORKS}")
		return
	supplied = os.environ.get("LINDA_LIBLOUIS_VERSION")
	if supplied is None:
		print("liblouis: not compared, as only the dev shell says which release nixpkgs supplies")
	elif supplied != release:
		print(f"liblouis: nixpkgs supplies {supplied}, upstream pins {release}")
	else:
		print(f"liblouis: {release}, as upstream pins")


def main() -> int:
	sys.stdout.reconfigure(line_buffering=True)
	print(f"checking upstream files against {EDITS} and {FORKS}")
	try:
		os.chdir(git("rev-parse", "--show-toplevel").strip())
		base = upstreamRef()
		editErrors, edited = checkEdits(base)
		forkErrors, forked = checkForks(base)
		errors = editErrors + forkErrors + checkNixPins(base)
		reportLiblouis(base)
	except (Failure, OSError, SyntaxError, ValueError) as error:
		print(error, file=sys.stderr)
		return 1
	for line in errors:
		print(line, file=sys.stderr)
	if errors:
		return 1
	print(f"{edited} upstream files differ, all listed; {forked} forks match upstream")
	return 0


if __name__ == "__main__":
	sys.exit(main())
