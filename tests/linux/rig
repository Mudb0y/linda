#!/usr/bin/env bash
# Runs a command in a sandbox with its own X display, session bus,
# accessibility bus, HOME and runtime directory. The sandbox has its own
# process, network and IPC namespaces, no sound or input devices, none of the
# live session's sockets or files, and no environment but what the dev shell
# itself provides. So nothing started here can reach the live desktop, its
# screen reader, its sound server or the keyboard, and nothing here depends
# on the host's desktop. That is what makes it safe to crash a screen reader
# under test.
#
# Inside, the checkout and the system are read-only and /tmp is empty.
# --bind DIR makes DIR visible and writable, for results that should outlive
# the run or scripts kept outside the checkout. The locale is C.UTF-8 and the
# time zone UTC, and of the caller's variables only LINDA_ and BENCH_
# ones get in; anything else goes through env, as in
# rig env LANG=pl_PL.UTF-8 command.
#
# LINDA_RIG_NET=1 in the caller's environment gives the sandbox the
# internet, through pasta, a network stack in user space: still a network
# namespace of its own, so the live display's abstract socket and anything on
# the host's loopback stay out of reach, with no port forwarded either way,
# the host's own addresses shut off, and names resolved through a nameserver
# address that pasta passes to the host's resolver and nowhere else.
#
# LINDA_RIG_COMPOSITOR=mutter or sway gives the sandbox a Wayland session
# instead of the X display, with a headless compositor on a virtual monitor of
# the same size and a virtual keyboard in the pl layout that tests press keys
# on through tests/linux/waylandKeyboard.py. Mutter has its accessibility
# manager on the sandbox's session bus; sway puts swaymsg on PATH.
# LINDA_RIG_SESSION=wayland alone means Mutter, and LINDA_RIG_XWAYLAND=1 lets
# the compositor start Xwayland beside it, whose display alone is then
# DISPLAY. Nothing about the X mode changes when the variables are unset.
# LINDA_RIG_MUTTER_SETTINGS names a GVariant keyfile, as GLib's keyfile
# settings backend reads one, that Mutter alone starts with, in place of the
# empty memory backend everything else in the sandbox has; the file must be
# visible in the sandbox, and Mutter is given a copy of it.
#
# The exit status is the command's, or 125 when the rig itself failed.
set -euo pipefail

fail() {
	echo "rig: $*" >&2
	exit 125
}

self=$(realpath -e -- "$0")

# The first step of a networked sandbox, in a user and network namespace of
# its own: it waits there while the rig outside connects pasta to the
# namespace and shuts off the host's addresses in it, then becomes the
# sandbox, which keeps that network namespace.
if [ "${1:-}" = --network ]; then
	[ "${LINDA_RIG:-}" = 1 ] ||
		fail "--network is the rig's own and runs only in the namespace it makes"
	: >"$2"
	read -r _ <"$3" || fail "the network was never connected"
	shift 4
	exec "$@"
fi

if [ "${1:-}" = --inside ]; then
	# This half sets itself up against whatever session it finds, so it must
	# only ever run as the sandbox's own command. The variable alone could be
	# copied into another shell; the other two hold nowhere but in there.
	if [ "${LINDA_RIG:-}" != 1 ] || [ -e /run/user ] ||
		[ "$(cat /proc/1/comm 2>/dev/null)" != bwrap ]; then
		fail "--inside is the rig's own second half and runs only in its sandbox"
	fi
	shift
	compositor=${LINDA_RIG_COMPOSITOR:-}
	case $compositor in
	'' | mutter | sway) ;;
	*) fail "LINDA_RIG_COMPOSITOR is mutter or sway, not $compositor" ;;
	esac
	session=${LINDA_RIG_SESSION:-}
	case $session in
	'') session=x11 && [ -n "$compositor" ] && session=wayland ;;
	x11) [ -z "$compositor" ] || fail "LINDA_RIG_COMPOSITOR is for a Wayland session, not x11" ;;
	wayland) ;;
	*) fail "LINDA_RIG_SESSION is x11 or wayland, not $session" ;;
	esac
	case ${LINDA_RIG_XWAYLAND:-} in
	'' | 0) xwayland= ;;
	1) xwayland=1 ;;
	*) fail "LINDA_RIG_XWAYLAND is 1 for Xwayland or unset for none, not $LINDA_RIG_XWAYLAND" ;;
	esac
	if [ "$session" = wayland ]; then
		[ -z "${LINDA_RIG_WM:-}" ] || fail "LINDA_RIG_WM is for the X session; the compositor manages windows here"
		compositor=${compositor:-mutter}
		export LINDA_RIG_COMPOSITOR=$compositor LINDA_RIG_SESSION=wayland
	else
		[ -z "$xwayland" ] || fail "LINDA_RIG_XWAYLAND is for a Wayland session"
	fi
	mutterSettings=${LINDA_RIG_MUTTER_SETTINGS:-}
	if [ -n "$mutterSettings" ]; then
		[ "$compositor" = mutter ] || fail "LINDA_RIG_MUTTER_SETTINGS is for a Mutter session"
		[ -f "$mutterSettings" ] && [ -r "$mutterSettings" ] ||
			fail "LINDA_RIG_MUTTER_SETTINGS names no file the sandbox can read: $mutterSettings"
	fi
	if [ "$session" = x11 ]; then
		# -noreset, because the server otherwise resets when its first client
		# leaves and drops the root window property the accessibility bus is
		# advertised on, which is how clients find that bus on a real desktop.
		# A number the live display never has, so that a DISPLAY that somehow
		# got out of the sandbox would name nothing.
		Xvfb :99 -displayfd 3 -screen 0 1280x1024x24 -nolisten tcp -noreset \
			3>"$XDG_RUNTIME_DIR/display" 2>"$XDG_RUNTIME_DIR/xvfb.log" &
		# The server writes its display number once it accepts connections.
		for _ in $(seq 200); do
			[ -s "$XDG_RUNTIME_DIR/display" ] && break
			sleep 0.05
		done
		if [ ! -s "$XDG_RUNTIME_DIR/display" ]; then
			cat "$XDG_RUNTIME_DIR/xvfb.log" >&2
			fail "the X server did not start"
		fi
		export DISPLAY=:99
	fi

	"$AT_SPI_BUS_LAUNCHER" --launch-immediately &
	up=
	for _ in $(seq 100); do
		# Asking the bus who owns the name, rather than calling the launcher:
		# the session bus here can start nothing by itself, so a launcher
		# that died shows as a failure instead of being quietly replaced.
		if dbus-send --session --print-reply --dest=org.freedesktop.DBus \
			/org/freedesktop/DBus org.freedesktop.DBus.NameHasOwner \
			string:org.a11y.Bus 2>/dev/null | grep -q 'boolean true'; then
			up=1
			break
		fi
		sleep 0.05
	done
	[ -n "$up" ] || fail "the accessibility bus did not start"
	# Toolkits and browsers build their accessibility trees only once
	# something claims to be an assistive technology.
	set_status() {
		dbus-send --session --print-reply --dest=org.a11y.Bus /org/a11y/bus \
			org.freedesktop.DBus.Properties.Set \
			string:org.a11y.Status string:"$1" variant:boolean:true >/dev/null
	}
	set_status IsEnabled || fail "could not switch accessibility on"
	# Only some at-spi2-core builds have this one.
	set_status ScreenReaderEnabled 2>/dev/null || true
	if [ "$session" = wayland ]; then
		# A compositor's socket, by its name in the runtime directory: the
		# command's WAYLAND_DISPLAY, and what each waits for below.
		socket=
		if [ -n "$xwayland" ]; then
			# Both compositors refuse a socket directory anyone could replace
			# sockets in, and both take the first display number whose lock file
			# names no live process. These name the sandbox's first process, so
			# that the display is none a live desktop has, as Xvfb's is.
			chmod 1777 /tmp/.X11-unix
			for number in $(seq 0 9); do
				printf '%10d\n' 1 >"/tmp/.X$number-lock"
			done
		fi
		if [ "$compositor" = mutter ]; then
			[ -n "${LINDA_MUTTER:-}" ] || fail "LINDA_MUTTER is not set; run inside the dev shell"
			# Headless, so that it opens no device and reads no input of its own:
			# its only keyboard is the virtual one below. Xwayland only on request,
			# so that a client which falls back to X fails instead of passing
			# quietly through it.
			x11=(--no-x11)
			[ -n "$xwayland" ] && x11=()
			settings=()
			if [ -n "$mutterSettings" ]; then
				# A copy, so that what Mutter writes back stays in the run.
				config=$XDG_RUNTIME_DIR/mutter-config
				mkdir -p "$config/glib-2.0/settings"
				cp -- "$mutterSettings" "$config/glib-2.0/settings/keyfile"
				settings=(GSETTINGS_BACKEND=keyfile XDG_CONFIG_HOME="$config")
			fi
			env "${settings[@]}" XDG_DATA_DIRS="$LINDA_MUTTER_SCHEMAS:$XDG_DATA_DIRS" \
				__EGL_VENDOR_LIBRARY_FILENAMES="$LINDA_MESA/share/glvnd/egl_vendor.d/50_mesa.json" \
				LIBGL_DRIVERS_PATH="$LINDA_MESA/lib/dri" GBM_BACKENDS_PATH="$LINDA_MESA/lib/gbm" \
				"$LINDA_MUTTER" --headless --wayland "${x11[@]}" --wayland-display=wayland-rig \
				--virtual-monitor 1280x1024 >"$XDG_RUNTIME_DIR/mutter.log" 2>&1 &
			for _ in $(seq 200); do
				[ -S "$XDG_RUNTIME_DIR/wayland-rig" ] && break
				sleep 0.05
			done
			if [ ! -S "$XDG_RUNTIME_DIR/wayland-rig" ]; then
				cat "$XDG_RUNTIME_DIR/mutter.log" >&2
				fail "Mutter did not start"
			fi
			socket=wayland-rig
			if [ -n "$xwayland" ]; then
				# Mutter gives the display and its cookie only to programs it starts.
				display=$(grep -o 'Using public X11 display :[0-9]*' "$XDG_RUNTIME_DIR/mutter.log" |
					grep -o ':[0-9]*$') || fail "Mutter named no X display"
				cookie=$(ls "$XDG_RUNTIME_DIR"/.mutter-Xwaylandauth.* 2>/dev/null) ||
					fail "Mutter wrote no X cookie"
			fi
		else
			[ -n "${LINDA_SWAY_BIN:-}" ] || fail "LINDA_SWAY_BIN is not set; run inside the dev shell"
			# sway names its own socket and its Xwayland's display only to the
			# programs it starts, so the first of them writes them down.
			# Xwayland, when asked for, starts as Mutter's does: when a client
			# first connects.
			if [ -n "$xwayland" ]; then
				x11='xwayland enable'
			else
				x11='xwayland disable'
			fi
			cat >"$XDG_RUNTIME_DIR/sway.conf" <<-EOF
				output HEADLESS-1 resolution 1280x1024
				$x11
				exec printf '%s %s\\n' "\$WAYLAND_DISPLAY" "\${DISPLAY:--}" >"$XDG_RUNTIME_DIR/sway.names.new" && mv "$XDG_RUNTIME_DIR/sway.names.new" "$XDG_RUNTIME_DIR/sway.names"
			EOF
			export SWAYSOCK=$XDG_RUNTIME_DIR/sway.sock
			# The headless backend, which wants no seat, session or device, and
			# the renderer that draws in memory, which wants no GPU. Without the
			# first wlroots would pick a backend from what it finds.
			env WLR_BACKENDS=headless WLR_RENDERER=pixman WLR_HEADLESS_OUTPUTS=1 \
				"$LINDA_SWAY_BIN/sway" --config "$XDG_RUNTIME_DIR/sway.conf" \
				>"$XDG_RUNTIME_DIR/sway.log" 2>&1 &
			for _ in $(seq 200); do
				[ -s "$XDG_RUNTIME_DIR/sway.names" ] && [ -S "$SWAYSOCK" ] && break
				sleep 0.05
			done
			if [ ! -s "$XDG_RUNTIME_DIR/sway.names" ] || [ ! -S "$SWAYSOCK" ]; then
				cat "$XDG_RUNTIME_DIR/sway.log" >&2
				fail "sway did not start"
			fi
			read -r socket display <"$XDG_RUNTIME_DIR/sway.names"
			[ -S "$XDG_RUNTIME_DIR/$socket" ] || fail "sway named no socket of its own"
			if [ -n "$xwayland" ]; then
				[ "$display" != - ] || fail "sway named no X display"
				cookie=
			fi
			export PATH=$LINDA_SWAY_BIN:$PATH
		fi
		export WAYLAND_DISPLAY=$socket XDG_SESSION_TYPE=wayland
		# Never Xvfb's: a Wayland run with it would quietly test the X route.
		unset DISPLAY XAUTHORITY
		if [ -n "$xwayland" ]; then
			export DISPLAY=$display
			[ -z "$cookie" ] || export XAUTHORITY=$cookie
		fi
		# The seat has a keyboard only while a virtual one exists, and a
		# window without the keyboard never becomes active; this one also
		# presses the tests' keys.
		python3 -I "$(dirname "$self")/waylandKeyboard.py" serve "$XDG_RUNTIME_DIR/keyboard" \
			2>"$XDG_RUNTIME_DIR/keyboard.log" &
		for _ in $(seq 200); do
			[ -S "$XDG_RUNTIME_DIR/keyboard" ] && break
			sleep 0.05
		done
		if [ ! -S "$XDG_RUNTIME_DIR/keyboard" ]; then
			cat "$XDG_RUNTIME_DIR/keyboard.log" >&2
			fail "the virtual keyboard did not start"
		fi
	fi
	# A window manager on request, so that a test can have an active window,
	# focus that moves between windows when they open and close, and the
	# root window properties a real desktop has.
	if [ -n "${LINDA_RIG_WM:-}" ]; then
		[ "$LINDA_RIG_WM" = marco ] || fail "unknown window manager: $LINDA_RIG_WM"
		marco --no-force-fullscreen >"$XDG_RUNTIME_DIR/wm.log" 2>&1 &
		up=
		for _ in $(seq 100); do
			# It names itself before it has set up the desktops tests read.
			if xprop -root _NET_SUPPORTING_WM_CHECK _NET_NUMBER_OF_DESKTOPS 2>/dev/null |
				grep -q '^_NET_NUMBER_OF_DESKTOPS(CARDINAL)'; then
				up=1
				break
			fi
			sleep 0.05
		done
		if [ -z "$up" ]; then
			cat "$XDG_RUNTIME_DIR/wm.log" >&2
			fail "the window manager did not start"
		fi
	fi
	# The sandbox is a background job of a shell without job control, and such
	# a job starts with SIGINT and SIGQUIT ignored, which everything below it
	# would inherit.
	exec env --default-signal=INT,QUIT "$@"
fi

usage() {
	echo "usage: rig [--bind DIR]... command [argument...]" >&2
	exit 125
}

# Whether $1 is $2 or lies inside it.
within() {
	case "$1/" in "$2"/*) return 0 ;; esac
	return 1
}

if [ -z "${AT_SPI_BUS_LAUNCHER:-}" ] || [ -z "${LINDA_RIG_PATH:-}" ]; then
	fail "run inside the dev shell, nix develop"
fi
case "${LINDA_RIG_NET:-}" in
'' | 0) network= ;;
1) network=1 ;;
*) fail "LINDA_RIG_NET is 1 for the internet or unset for none, not $LINDA_RIG_NET" ;;
esac

checkout=$(dirname "$(dirname "$(dirname "$self")")")
# A worktree keeps its history in the main checkout, and git needs to read it.
history=$(git -C "$checkout" rev-parse --path-format=absolute --git-common-dir) ||
	fail "$checkout is not a git checkout"
history=$(realpath -e -- "$history")
liveHome=$(realpath -e -- "$HOME")

binds=()
bound=()
while [ "${1:-}" = --bind ]; do
	[ $# -ge 2 ] || usage
	dir=$(realpath -e -- "$2" 2>/dev/null) || fail "--bind: no such directory: $2"
	[ -d "$dir" ] || fail "--bind takes a directory: $2"
	[ "$dir" != / ] || fail "--bind: / would put the whole live system in the sandbox"
	# A bind is mounted over everything set up before it. These hold the
	# live session's sockets and devices, or must stay read-only, so nothing
	# in them, and nothing that contains them, may be bound.
	for kept in /run /dev /proc /sys /tmp/.X11-unix /tmp/.ICE-unix "$checkout" "$history"; do
		if within "$dir" "$kept" || within "$kept" "$dir"; then
			fail "--bind: $dir would expose $kept"
		fi
	done
	# These may have single directories bound out of them, but not the whole.
	for kept in /tmp /home "$liveHome" /nix /etc /usr /bin /var; do
		if within "$kept" "$dir"; then
			fail "--bind: $dir would expose all of $kept"
		fi
	done
	# Settings of the live session's programs, the screen reader's among them.
	case "$dir/" in "$liveHome"/.* | "$liveHome"/nixos/*)
		fail "--bind: $dir holds the live session's own settings"
		;;
	esac
	binds+=(--bind "$dir" "$dir")
	bound+=("$dir")
	shift 2
done
[ $# -gt 0 ] || usage

# The caller's directory if the sandbox has it, so that relative paths mean
# what the caller meant; otherwise the checkout, where a relative path that
# meant somewhere else fails instead of naming the wrong file.
start=$checkout
here=$(pwd -P)
for visible in "$checkout" "${bound[@]}"; do
	if within "$here" "$visible"; then
		start=$here
	fi
done

root=$(mktemp -d "${TMPDIR:-/tmp}/linda-rig.XXXXXX") || fail "cannot make a working directory"
mkdir -m 700 "$root/home" "$root/run"

sandbox=
helper=
cleanup() {
	if [ -n "$sandbox" ]; then
		# Everything inside dies with the sandbox's first process, and that
		# one dies with bwrap.
		kill -KILL "$sandbox" 2>/dev/null || true
		wait "$sandbox" 2>/dev/null || true
	fi
	# pasta leaves by itself once the sandbox is gone, but not at once.
	if [ -n "$helper" ]; then
		kill -KILL "$helper" 2>/dev/null || true
		wait "$helper" 2>/dev/null || true
	fi
	# A command may leave directories it made unwritable. Nothing here may
	# fail: under set -e that would replace the command's exit status.
	chmod -R u+rwx "$root" 2>/dev/null || true
	rm -rf "$root" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# The /nix/store entries of a colon-separated list.
storeOnly() {
	local IFS=: entries entry kept=()
	read -ra entries <<<"$1"
	for entry in "${entries[@]}"; do
		if [[ $entry == /nix/store/* ]]; then
			kept+=("$entry")
		fi
	done
	echo "${kept[*]}"
}

# The sandbox's whole environment. Starting from nothing rather than from
# the caller's: a desktop session exports dozens of variables that make
# programs load its modules, start its services and read its settings.
variables=()
for name in "${!LINDA_@}" "${!BENCH_@}" AT_SPI_BUS_LAUNCHER GI_TYPELIB_PATH \
	GDK_PIXBUF_MODULE_FILE LOCALE_ARCHIVE; do
	if [ -n "${!name:-}" ]; then
		variables+=("$name=${!name}")
	fi
done
variables+=(
	"PATH=$(storeOnly "$LINDA_RIG_PATH")"
	"XDG_DATA_DIRS=$(storeOnly "${LINDA_RIG_XDG_DATA_DIRS:-}")"
	"HOME=$root/home"
	"USER=$(id -un)"
	"LOGNAME=$(id -un)"
	"TERM=${TERM:-dumb}"
	LANG=C.UTF-8
	TZ=UTC
	TMPDIR=/tmp
	"XDG_RUNTIME_DIR=$root/run"
	"XDG_CONFIG_HOME=$root/home/.config"
	"XDG_CACHE_HOME=$root/home/.cache"
	"XDG_DATA_HOME=$root/home/.local/share"
	"XDG_STATE_HOME=$root/home/.local/state"
	# Sockets that do not exist, so that a client which goes looking fails
	# at once with a plain error instead of probing for a fallback.
	"PULSE_SERVER=unix:$root/run/no-sound-server"
	"DBUS_SYSTEM_BUS_ADDRESS=unix:path=$root/run/no-system-bus"
	GSETTINGS_BACKEND=memory
	GNOME_ACCESSIBILITY=1
	QT_ACCESSIBILITY=1
	QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1
	# Several runs share the checkout; bytecode caches written into it by
	# one would be read by the others.
	PYTHONDONTWRITEBYTECODE=1
	"PYTEST_ADDOPTS=-p no:cacheprovider"
	LINDA_RIG=1
)

# A cgroup of its own with a limit on memory, where the session's systemd
# will make one: a test that runs away is then killed inside it, where
# otherwise the kernel, or systemd-oomd with the whole login session's
# cgroup, picks what dies. A rig started inside a rig is already in one.
scope=()
if [ -z "${LINDA_RIG:-}" ] && command -v systemd-run >/dev/null 2>&1 &&
	systemd-run --user --scope --quiet --collect true 2>/dev/null; then
	scope=(systemd-run --user --scope --quiet --collect
		-p "MemoryMax=${LINDA_RIG_MEMORY:-16G}" -p MemorySwapMax=0 --)
fi

namespaces=(--unshare-all)
stack=()
if [ -n "$network" ]; then
	for program in pasta unshare nsenter ip; do
		command -v "$program" >/dev/null || fail "$program is not on the dev shell's PATH"
	done
	# Not an address of the host or of any network it is on: pasta answers it
	# itself and passes only queries on the DNS ports to the host's resolver.
	nameserver=169.254.1.1
	printf 'nameserver %s\n' "$nameserver" >"$root/resolv.conf"
	mkfifo "$root/network-go"
	# bwrap keeps the namespace unshare made, so that pasta, which joins it
	# from outside, never runs inside the sandbox.
	namespaces=(--unshare-all --share-net
		--ro-bind "$root/resolv.conf" "$(realpath -m /etc/resolv.conf)")
	# A networked rig inside this one runs its own pasta in here.
	if [ -c /dev/net/tun ]; then
		namespaces+=(--dev-bind /dev/net/tun /dev/net/tun)
	fi
	stack=(unshare --user --map-current-user --net
		-- "$self" --network "$root/network-ready" "$root/network-go" --)
fi

# The dynamic loader of the host's own programs, which /usr/bin/env is
# when it runs a script's #! line in here. Outside NixOS the ELF header
# names it under /lib64 or /lib, often links into /usr, and exec fails
# with "No such file or directory" without them. Either may be absent,
# as on NixOS.
loader=()
for dir in /lib64 /lib; do
	if [ -e "$dir" ]; then
		loader+=(--ro-bind "$dir" "$dir")
	fi
done

# Python only to close every descriptor the caller left open, which could
# be a socket to something live, before bwrap takes this process's place.
# Standard input is named because a background job otherwise gets
# /dev/null, and a script piped to the command would silently not run.
"${scope[@]}" env -i "${variables[@]}" python3 -I -S -c '
import os, sys
os.closerange(3, 1 << 20)
os.execvp(sys.argv[1], sys.argv[1:])
' "${stack[@]}" bwrap --die-with-parent --new-session \
	--ro-bind /nix /nix --ro-bind /etc /etc --ro-bind /sys /sys \
	--ro-bind /bin /bin --ro-bind /usr /usr "${loader[@]}" \
	--dev /dev --proc /proc --tmpfs /tmp --dir /tmp/.X11-unix --tmpfs /run \
	"${namespaces[@]}" \
	--ro-bind "$checkout" "$checkout" --ro-bind "$history" "$history" \
	--bind "$root" "$root" "${binds[@]}" --chdir "$start" \
	-- dbus-run-session --config-file="$(dirname "$self")/rig-session.conf" \
	-- "$self" --inside "$@" 0<&0 &
sandbox=$!

if [ -n "$network" ]; then
	for _ in $(seq 200); do
		[ -e "$root/network-ready" ] && break
		kill -0 "$sandbox" 2>/dev/null || break
		sleep 0.05
	done
	[ -e "$root/network-ready" ] || fail "could not make the sandbox's network namespace"
	# No port forwarded either way, and the host's loopback not mapped onto
	# any address in there.
	pasta --quiet --foreground --config-net \
		-t none -u none -T none -U none \
		--map-host-loopback none --map-guest-addr none \
		--dns-forward "$nameserver" "$sandbox" &
	helper=$!
	enter=(nsenter --target "$sandbox" --user --net --preserve-credentials)
	up=
	for _ in $(seq 200); do
		if [ -n "$("${enter[@]}" ip -4 route show default 2>/dev/null)" ]; then
			up=1
			break
		fi
		kill -0 "$helper" 2>/dev/null || break
		sleep 0.05
	done
	[ -n "$up" ] || fail "pasta did not connect the sandbox's network"
	# pasta reaches every address from the host's side, so without these the
	# host's other interfaces, and whatever listens on all addresses, would
	# answer from in there. The address pasta copies into the namespace is
	# the namespace's own, and connections to it stay inside.
	while read -r _ interface _ address _; do
		[ "$interface" != lo ] || continue
		address=${address%/*}
		# A host without IPv6 has none of its addresses to shut off.
		"${enter[@]}" --keep-caps ip route add prohibit "$address" 2>/dev/null ||
			{ [[ $address == *:* ]] && [ ! -e /proc/net/if_inet6 ]; } ||
			fail "could not shut off the host's address $address"
	done < <(ip -o address show)
	echo >"$root/network-go"
fi

status=0
wait "$sandbox" || status=$?
sandbox=
exit "$status"
