#!/bin/sh
# As %systemd_postun_with_restart: on an upgrade a running service is restarted, which systemd's
# file trigger does at the end of the transaction for a unit marked here.
if [ "$1" -ge 1 ]; then
	if [ -x /usr/lib/systemd/systemd-update-helper ]; then
		/usr/lib/systemd/systemd-update-helper mark-restart-system-units linda-keyd.service || :
	elif [ -d /run/systemd/system ]; then
		systemctl try-restart linda-keyd.service >/dev/null 2>&1 || :
	fi
fi
