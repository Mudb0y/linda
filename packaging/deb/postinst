#!/bin/sh
# As debhelper writes it for a sysusers file and a service: the user is made, and the service is
# enabled and started on a first install, restarted on an upgrade, and left as the administrator
# left it otherwise.
set -e

if [ "$1" = configure ] || [ "$1" = abort-upgrade ] || [ "$1" = abort-deconfigure ] || [ "$1" = abort-remove ]; then
	systemd-sysusers ${DPKG_ROOT:+--root="$DPKG_ROOT"} linda-keyd.conf

	if deb-systemd-helper --quiet was-enabled linda-keyd.service; then
		deb-systemd-helper enable linda-keyd.service >/dev/null || true
	else
		deb-systemd-helper update-state linda-keyd.service >/dev/null || true
	fi

	if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
		# modules-load.d is read at boot; the unit wants /dev/uinput now.
		modprobe uinput >/dev/null 2>&1 || true
		systemctl --system daemon-reload >/dev/null || true
		if [ -n "$2" ]; then
			action=restart
		else
			action=start
		fi
		deb-systemd-invoke "$action" linda-keyd.service >/dev/null || true
	fi
fi
