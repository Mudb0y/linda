# linda-keyd takes the keyboards in the kernel for Linda while Linda, in the session in front, asks
# it to. A keyboard it holds cannot be used by anything else, so this unit is about ending it when it
# stops making progress as much as about confining it: the kernel lets go of whatever a dead process
# held, and Linda goes back to taking keys through X.
[Unit]
Description=Linda's key capture helper
# It follows logind and asks polkit on the system bus; it waits for the bus by itself when the bus is
# not there yet, holding nothing meanwhile.
After=dbus.service
# A helper that keeps being ended stays stopped, and Linda keeps taking keys through X: a fault that
# came back at every capture would otherwise leave the keyboard dead for a second every few seconds
# for as long as it lasted. A capture and an end take four seconds at the least, the virtual
# keyboard's second and the watchdog's among them, so five starts in two minutes trip within half
# a minute of such a fault, while a crash now and then, or a restart by hand, comes nowhere near.
# systemctl reset-failed linda-keyd lets it be started again.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
# Its access to /dev/uinput: an entry in the node's access list, leaving the node's owner, group and
# mode to whatever else sets them. Set by systemd with full privileges (the +) before each start,
# since udev and logind take every other user's entry off a node tagged uaccess, as Steam's rules tag
# this one, whenever a session comes to the front; the helper opens the node as it starts and keeps
# it. A failure (the -) leaves the helper running, unable to make its virtual keyboard and so never
# grabbing, which it says in the log.
ExecStartPre=-+@SETFACL@ -m u:linda-keyd:rw /dev/uinput
ExecStart=@KEYD@
User=linda-keyd
Group=linda-keyd
# The keyboards' event nodes.
SupplementaryGroups=input
RuntimeDirectory=linda-keyd
# Every local user may connect: who becomes the client is decided by logind and polkit.
RuntimeDirectoryMode=0755

# Its loop feeds the watchdog every half second, holding a keyboard or not. Its own watchdog thread lets
# go and ends it after one second without progress; this is for when that thread cannot run either,
# as when the process is stopped, which SIGABRT ends as it would a running one. SIGKILL follows a
# second later for a process that SIGABRT did not end.
WatchdogSec=2
TimeoutAbortSec=1
Restart=always
RestartSec=1
# Losing it to the out-of-memory killer loses Linda's keys until it is back.
OOMScoreAdjust=-900
# A dump would hold keys typed, passwords among them.
LimitCORE=0

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=char-input rw
DeviceAllow=/dev/uinput rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Not ProtectProc=invisible: admission reads the start time of a client of another user from
# /proc/PID/stat, as polkit identifies the process by it.
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
PrivateIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
