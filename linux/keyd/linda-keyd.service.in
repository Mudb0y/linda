# linda-keyd takes the keyboards in the kernel for Linda while Linda, in the session in front, asks
# it to. A keyboard it holds cannot be used by anything else, so this unit is about ending it when it
# stops making progress as much as about confining it: the kernel lets go of whatever a dead process
# held, and the keyboards work again without Linda until the helper is back.
[Unit]
Description=Linda's key capture helper
# It follows logind and asks polkit on the system bus; it waits for the bus by itself when the bus is
# not there yet, holding nothing meanwhile.
After=dbus.service
# systemd creates a file it is to open for writing that is not there, and a regular file at
# /dev/uinput would stand in uinput's way; the node is there once the module is loaded at boot, or
# as kmod's static node before.
ConditionPathExists=/dev/uinput
# A helper that keeps being ended is left failed, and Linda has none of its keys: a fault that came
# back at every capture would otherwise leave the keyboard dead for a second or more every few
# seconds for as long as it lasted. Three starts within two minutes trip it, which a fault at every
# capture does within about ten seconds, at a cost of up to three such dead moments, and a crash now
# and then or a restart by hand does not. It is not stopped for good: once two minutes have passed,
# any start starts it again, and a boot or a nixos-rebuild switch (which starts every target, and
# with multi-user.target every unit it wants) is such a start. systemctl reset-failed linda-keyd
# forgets the starts counted, so that it can be started again at once.
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
# /dev/uinput, opened by systemd as root before the user is changed and handed over as standard
# input; naming it for standard output too is what makes systemd open it once, for reading and
# writing (since systemd 236). The helper keeps it for its life and needs no access of its own,
# which udev and logind would take away whenever they pass over a node tagged for the user in front,
# as Steam's rules tag this one. Standard error stays the journal's.
StandardInput=file:/dev/uinput
StandardOutput=file:/dev/uinput
StandardError=journal
ExecStart=@KEYD@
User=linda-keyd
Group=linda-keyd
# The keyboards' event nodes.
SupplementaryGroups=input
RuntimeDirectory=linda-keyd
# Every local user may connect: who becomes the client is decided by logind and polkit.
RuntimeDirectoryMode=0755

# Its loop feeds the watchdog every half second, holding a keyboard or not. Its own watchdog thread lets
# go and ends it after one second without progress; this is for when that thread cannot run either,
# as when the process is stopped. SIGKILL rather than systemd's SIGABRT, which the kernel would make
# a core dump of, piped to systemd-coredump whatever LimitCORE says, while the dying helper still held
# its grabs; SIGKILL ends a stopped process too (WatchdogSignal= is in systemd since 240).
WatchdogSec=2
WatchdogSignal=SIGKILL
TimeoutAbortSec=1
Restart=always
RestartSec=1
# Losing it to the out-of-memory killer loses Linda's keys until it is back.
OOMScoreAdjust=-900
# A dump would hold keys typed, passwords among them.
LimitCORE=0

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=char-input rw
DeviceAllow=/dev/uinput rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Not ProtectProc=invisible: admission reads the start time of a client of another user from
# /proc/PID/stat, as polkit identifies the process by it.
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
PrivateIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
